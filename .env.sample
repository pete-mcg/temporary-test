# Debugging
DEBUG=true

# Environment
APP_ENV=development

# User Interface
UI_SHOW_HISTORY=False
UI_SHOW_SHARE_BUTTON=False
UI_SHOW_SETTINGS=False
UI_SHOW_FEEDBACK=False
UI_TAB_TITLE=AI Chatbot
UI_SHOW_TOUR=True
UI_TITLE=AI Chatbot
UI_KNOWLEDGE_BASE=Data Source
UI_CHAT_DESCRIPTION=
UI_EXAMPLE_PROMPT_TITLE_1=How do I get the best responses from this tool?
UI_EXAMPLE_PROMPT_1=How do I get the best responses from this tool?
UI_EXAMPLE_PROMPT_ICON_1=Lightbulb
UI_EXAMPLE_PROMPT_TITLE_2=What is the purpose of this tool?
UI_EXAMPLE_PROMPT_2=What is the purpose of this tool?
UI_EXAMPLE_PROMPT_ICON_2=Info
UI_EXAMPLE_PROMPT_TITLE_3=Give me some sample questions that you can help me with
UI_EXAMPLE_PROMPT_3=Give me some sample questions that you can help me with
UI_EXAMPLE_PROMPT_ICON_3=ClipboardList

# Application Settings
SCM_DO_BUILD_DURING_DEPLOYMENT=true

# Azure CosmosDB
AZURE_COSMOSDB_ACCOUNT=
AZURE_COSMOSDB_CONVERSATIONS_CONTAINER=conversations
AZURE_COSMOSDB_DATABASE=db_conversation_history
AZURE_COSMOSDB_ENABLE_FEEDBACK=true
AZURE_MANAGED_IDENTITY_ID=

# Azure Open AI Service
AZURE_OPENAI_STREAM=true
AZURE_OPENAI_EMBEDDING_NAME=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MAX_TOKENS=1000
AZURE_OPENAI_MODEL=
AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_SYSTEM_MESSAGE=You are an AI assistant that helps people find information.
AZURE_OPENAI_TEMPERATURE=0
AZURE_OPENAI_TOP_P=1

# Azure AI Search Service & Index
DATASOURCE_TYPE=azure_search
AZURE_SEARCH_ENABLE_IN_DOMAIN=True
AZURE_SEARCH_INDEX=
AZURE_SEARCH_QUERY_TYPE=vector_simple_hybrid
AZURE_SEARCH_SERVICE=
AZURE_SEARCH_STRICTNESS=3
AZURE_SEARCH_TOP_K=5
AZURE_SEARCH_USE_SEMANTIC_SEARCH=False

# Azure Storage Account
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_CONTAINER_NAME=documents

# Indexer Settings
AZURE_SEARCH_INDEX_CREATE=
AZURE_BLOB_CONNECTION_STRING=
MAX_CHUNK_LENGTH=5000
CHUNK_OVERLAP=500

# SSO & PUID
AUTH_ENABLED=
AUTH_HOST=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AUTH_SCOPE=
AUTH_REDIRECT_URI=
AUTH_VERIFY_SSL=

# REDIS
REDIS_HOST=
REDIS_PORT=