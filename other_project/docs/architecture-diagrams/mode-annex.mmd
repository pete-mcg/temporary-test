    post_generate[/"POST /annex/generate"/]
    annex_route["Quart annex_generate route"]
    cosmos_conversation[("Azure Cosmos DB<br/>create annex conversation<br/>save user message")]
    langgraph[["Compiled LangGraph workflow"]]

    get_cosmos_data["get_cosmos_data"]
    generate_cases_query["generate_cases_query"]
    mp_data[("Azure Cosmos DB<br/>MP data")]
    get_hansard_data["get_hansard_data"]
    get_defence_cases["get_defence_cases"]
    case_searches["Parallel case searches<br/>get_foi_cases<br/>get_pq_cases<br/>get_mc_cases<br/>get_to_cases"]
    hansard_index[("Search Hansard index")]
    core_index[("Search Core index<br/>(i.e. eCase records)")]
    hansard_results["Hansard search results"]
    defence_results["Defence case results"]
    parallel_case_results["Parallel case search results"]

    generate_response["generate_response"]
    retriever_llm_error{"LangGraph error?"}
    fallback["Fallback response"]
    annex_response["LLM response"]
    response_stream_enabled{"AZURE_OPENAI_STREAM<br/>true?"}
    json_response[/"JSON response"/]
    json_lines[/"JSON-lines stream"/]
    cosmos_save_response[("Azure Cosmos DB<br/>save assistant response<br/>save graph_state")]
