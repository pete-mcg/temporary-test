    end_node(["End"])

    open_dialog --> get_mp_list
    get_mp_list --> cosmos_mp
    cosmos_mp --> mp_options
    mp_options --> submit
    submit --> chat_tsx
    chat_tsx --> post_generate
    post_generate --> annex_route
    annex_route --> cosmos_conversation
    cosmos_conversation --> langgraph

    langgraph --> get_cosmos_data
    langgraph --> generate_cases_query

    get_cosmos_data --> mp_data
    mp_data --> get_hansard_data
    mp_data --> get_defence_cases
    get_hansard_data -. searches .-> hansard_index
    get_defence_cases -. searches .-> core_index
    hansard_index --> hansard_results
    core_index --> defence_results
    hansard_results --> generate_response
    defence_results --> generate_response

    generate_cases_query -->|query re-written| case_searches
    case_searches -. searches .-> core_index
    core_index --> parallel_case_results
    parallel_case_results --> generate_response

    generate_response --> retriever_llm_error
    retriever_llm_error -->|yes| fallback
    retriever_llm_error -->|no| annex_response
    fallback --> response_stream_enabled
    annex_response --> response_stream_enabled
    response_stream_enabled -->|no| json_response
    response_stream_enabled -->|yes| json_lines
    json_response --> cosmos_save_response
    json_lines --> cosmos_save_response
    cosmos_save_response --> frontend_render
    frontend_render --> end_node

