    class core_scrape,core_s3,core_email,core_meta,core_doclist,schema_core,chunk_core,embed_core,cosmos_mps,cosmos_estab,cosmos_interests,cosmos_visits,cosmos_committees,cosmos_payload,cosmos_upload,hansard_check,hansard_dl,hansard_jsonl,hansard_upload,schema_annex,chunk_annex,embed_annex processStyle
    class pipeline decisionStyle
    class core_sources_s3,core_sources_meta,core_sources_ico,src_members_api,src_interests_api,src_committees_api,src_estab_excel,src_visits_excel,src_hansard_api ioStyle
    class blob_core,search_core,cosmos_db,blob_hansard,search_hansard datastoreStyle
