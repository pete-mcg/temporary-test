flowchart TB
    run(["Scheduled/manual ops run"])
    pipeline{"Pipeline type?"}

    run --> pipeline

    %% CORE (ECASE + GUIDANCE) DATA INGESTION
    pipeline -->|core documents| core_ingest

    subgraph core_ingest ["ops/data-ingestion/core"]
        direction TB
        core_sources_s3[/"AWS S3<br>eCase files"/]
        core_sources_meta[/"Azure Blob Storage<br>eCase metadata<br>(CSV & Excel)"/]
        core_sources_ico[/"ICO website<br>guidance & FOIA PDF"/]

        core_scrape["Scrape ICO guidance &<br>FOIA legislation"]
        core_s3["Transfer case files<br>from AWS S3"]
        core_email["Extract attachments<br>from .eml/.msg files"]
        core_meta["Enrich blobs with metadata"]
        core_doclist["Generate document list"]

        core_sources_ico --> core_scrape
        core_sources_s3 --> core_s3
        core_sources_meta --> core_meta

        core_scrape --> core_meta
        core_s3 --> core_email --> core_meta --> core_doclist
    end

    core_doclist --> blob_core[("Azure Blob Storage<br>processed documents,<br>guidance & document list")]

    %% CORE (ECASE + GUIDANCE) INDEXER
    blob_core --> indexer_core

    subgraph indexer_core ["ops/indexer/core"]
        direction TB
        schema_core["Create / update<br>search index schema"]
        chunk_core["Split documents<br>into pages"]
        embed_core["Generate embeddings<br>(Azure OpenAI)"]

        schema_core --> chunk_core --> embed_core
    end

    embed_core --> search_core[("Azure AI Search<br>core index")]

    %% COSMOS MP DATA INGESTION (INFO ANNEX)
    pipeline -->|annex MP data| cosmos_ingest

    subgraph cosmos_ingest ["ops/data-ingestion/annex-cosmos"]
        direction TB
        src_members_api[/"UK Parliament<br>Members API"/]
        src_interests_api[/"UK Parliament<br>Interests API"/]
        src_committees_api[/"UK Parliament<br>Committees API"/]
        src_estab_excel[/"MOD Establishments<br>Excel (Azure Blob)"/]
        src_visits_excel[/"Parliamentary Visits<br>Excel (Azure Blob)"/]

        cosmos_mps["Fetch current MPs"]
        cosmos_estab["Match MOD establishments<br>to MPs (fuzzy match)"]
        cosmos_interests["Fetch financial interests"]
        cosmos_visits["Match parliamentary visits<br>to MPs (fuzzy match)"]
        cosmos_committees["Fetch committee memberships"]
        cosmos_payload["Build Cosmos DB payloads"]
        cosmos_upload["Upsert to Cosmos DB"]

        src_members_api --> cosmos_mps
        src_estab_excel --> cosmos_estab
        src_interests_api --> cosmos_interests
        src_visits_excel --> cosmos_visits
        src_committees_api --> cosmos_committees

        cosmos_mps --> cosmos_estab --> cosmos_interests --> cosmos_visits --> cosmos_committees --> cosmos_payload --> cosmos_upload
    end

    cosmos_upload --> cosmos_db[("Azure Cosmos DB<br>MP profile data")]

    %% HANSARD CONTRIBUTIONS INGESTION (INFO ANNEX)
    pipeline -->|annex Hansard data| hansard_ingest

    subgraph hansard_ingest ["ops/data-ingestion/annex-hansard"]
        direction TB
        src_hansard_api[/"UK Parliament<br>Hansard API"/]

        hansard_check["Check existing data<br>in Azure Blob"]
        hansard_dl["Download contributions<br>(Spoken, Written,<br>Corrections, Petitions)"]
        hansard_jsonl["Write daily JSONL files"]
        hansard_upload["Upload JSONL<br>to Azure Blob"]

        src_hansard_api --> hansard_dl
        hansard_check --> hansard_dl --> hansard_jsonl --> hansard_upload
    end

    hansard_upload --> blob_hansard[("Azure Blob Storage<br>Hansard JSONL files")]

    %% HANSARD CONTRIBUTIONS INDEXER (INFO ANNEX)
    blob_hansard --> indexer_annex

    subgraph indexer_annex ["ops/indexer/annex"]
        direction TB
        schema_annex["Create / update<br>search index schema"]
        chunk_annex["Split contributions<br>into pages"]
        embed_annex["Generate embeddings<br>(Azure OpenAI)"]

        schema_annex --> chunk_annex --> embed_annex
    end

    embed_annex --> search_hansard[("Azure AI Search<br>Hansard index")]

